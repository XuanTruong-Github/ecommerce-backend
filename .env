# ================================
# APP
# ================================
NODE_ENV=development
APP_ENV=local
APP_NAME=ecommerce-backend
APP_VERSION=1.0.0

TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CURRENCY=VND
DEFAULT_LOCALE=vi
DEFAULT_STORE_ID=default

# ================================
# API GATEWAY
# ================================
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=3000
API_GATEWAY_GLOBAL_PREFIX=api

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# ================================
# MONGODB
# ================================
MONGODB_USERNAME=truonglx
MONGODB_PASSWORD=truonglx0603
MONGODB_URI=mongodb://{MONGODB_USERNAME}:{MONGODB_PASSWORD}@localhost:27017/ecommerce?authSource=admin
MONGODB_DB=ecommerce
MONGODB_MIN_POOL_MIN_SIZE=5
MONGODB_MAX_POOL_MAX_SIZE=50

# ================================
# REDIS
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=truonglx0603
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=ecommerce:

# ================================
# RABBITMQ
# ================================
RABBITMQ_URI=amqp://truonglx:truonglx0603@localhost:5672
RABBITMQ_PREFETCH=10
RABBITMQ_EXCHANGE=ecommerce.events
RABBITMQ_DEFAULT_USER=truonglx
RABBITMQ_DEFAULT_PASS=truonglx0603

# ================================
# BETTER AUTH
# ================================
BETTER_AUTH_SECRET=vRQgvTteqdyBZ3otMQGjDATu6rV4maFq
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
BETTER_AUTH_SESSION_MAX_AGE=604800
BETTER_AUTH_COOKIE_SECURE=false
BETTER_AUTH_COOKIE_SAME_SITE=lax
BETTER_AUTH_COOKIE_NAME=ecommerce.session

# ================================
# LOGGING
# ================================
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true
BETTER_AUTH_URL=http://localhost:8080


# ================================
# ELASTICSEARCH
# ================================
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=truonglx0603
ELASTICSEARCH_INDEX_PREFIX=ecommerce_local
ELASTICSEARCH_REQUEST_TIMEOUT=30000

# ================================
# INTERNAL
# ================================
INTERNAL_API_TOKEN=truonglx

# ================================
# MEDIA
# ================================
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
PUBLIC_MEDIA_URL=http://localhost:3000/media

# ================================
# PRODUCT SERVICE
# ================================
PRODUCT_SERVICE_HOST=0.0.0.0
PRODUCT_SERVICE_PORT=3001
PRODUCT_SERVICE_URL=http://localhost:3001

# ================================
# SEARCH SERVICE
# ================================
SEARCH_SERVICE_HOST=0.0.0.0
SEARCH_SERVICE_PORT=3002
SEARCH_SERVICE_URL=http://localhost:3002

